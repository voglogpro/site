# Обязательные значения
BOT_TOKEN=123456:replace_me
WEBAPP_URL=https://your-bot.bothost.tech
# Пароль входа в CRM (не короче 10 символов). Telegram ID для входа не нужен.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
# Необязательно: только для служебных команд бота вроде загрузки фото.
ADMIN_IDS=
# Отдельный длинный секрет для QR. Не используйте BOT_TOKEN.
QR_SECRET=replace-with-at-least-32-random-characters

# BotHost
WEB_PORT=3000
DATA_DIR=/app/data
DB_NAME=bibibike_quest.db
TIMEZONE=Europe/Moscow

# Безопасность и приватность
INIT_DATA_MAX_AGE_SEC=43200
ADMIN_TICKET_TTL_SEC=43200
ADMIN_SESSION_TTL_SEC=43200
SESSION_DURATION_MIN=240
LOCATION_STALE_SEC=300
LOCATION_RETENTION_DAYS=7
SUPPORT_URL=https://t.me/replace_me
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
TILE_THEME=dark
TILE_PALETTE=night
ROUTING_UPSTREAM=https://routing.openstreetmap.de/routed-bike/route/v1
# 2ГИС MapGL: одного ключа достаточно для стандартной карты и плавного
# переключателя светлой/приглушённой тёмной темы без перезагрузки карты.
MAPGL_KEY=
# Необязательно: прежний один фиксированный Style ID (оставлен для совместимости).
MAPGL_STYLE=
# Необязательно: ID двух опубликованных стилей из https://styles.2gis.com.
# Если заполнить оба, переключатель использует настоящие стили 2ГИС через
# setStyleById(), сохраняя центр, маркеры и построенный маршрут.
MAPGL_STYLE_LIGHT=
MAPGL_STYLE_DARK=
MAPGL_DAILY_LIMIT=1500

# Только для локальной разработки. На хостинге оставить 0.
DEV_MODE=0
DEV_USER_ID=7785586524
